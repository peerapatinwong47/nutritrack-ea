        function closeEditMealModal() {
            document.getElementById('edit-meal-modal').classList.add('hidden');
        }

        function saveEditedMeal() {
            const id = document.getElementById('edit-meal-id').value;
            const name = document.getElementById('edit-meal-name').value.trim() || 'มื้ออาหารทั่วไป';
            const carb = parseFloat(document.getElementById('edit-meal-carb').value) || 0;
            const protein = parseFloat(document.getElementById('edit-meal-protein').value) || 0;
            const fat = parseFloat(document.getElementById('edit-meal-fat').value) || 0;

            const mealIndex = appState.meals.findIndex(m => m.id === id);
            if (mealIndex >= 0) {
                const cal = (carb * 4) + (protein * 4) + (fat * 9);
                appState.meals[mealIndex].name = name;
                appState.meals[mealIndex].carb = carb;
                appState.meals[mealIndex].protein = protein;
                appState.meals[mealIndex].fat = fat;
                appState.meals[mealIndex].cal = Math.round(cal);
            }

            saveStateToStorage();
            closeEditMealModal();
            renderDashboard();
            renderHistoryLogs();
            showToast('บันทึกการแก้ไขแล้ว');
        }

        function showToast(msg) {
            const toast = document.getElementById('toast-msg');
            const toastText = document.getElementById('toast-text');
            if (!toast || !toastText) return;

            toastText.innerText = msg;
            toast.classList.remove('opacity-0', 'pointer-events-none');
            toast.classList.add('opacity-100');

            setTimeout(() => {
                toast.classList.remove('opacity-100');
                toast.classList.add('opacity-0', 'pointer-events-none');
            }, 2500);
        }

