        function setLogMode(mode) {
            appState.logMode = mode;
            const btnGram = document.getElementById('mode-btn-gram');
            const btnPortion = document.getElementById('mode-btn-portion');
            const labelCarb = document.getElementById('label-carb');
            const labelProtein = document.getElementById('label-protein');
            const labelFat = document.getElementById('label-fat');
            const banner = document.getElementById('portion-info-banner');

            if (mode === 'gram') {
                btnGram.className = "px-2.5 py-1 rounded-md transition bg-white text-emerald-700 shadow-sm font-semibold";
                btnPortion.className = "px-2.5 py-1 rounded-md transition text-slate-500 hover:text-slate-800 font-semibold";
                labelCarb.innerText = "คาร์บ (กรัม)";
                labelProtein.innerText = "โปรตีน (กรัม)";
                labelFat.innerText = "ไขมัน (กรัม)";
                if(banner) banner.classList.add('hidden');
            } else {
                btnPortion.className = "px-2.5 py-1 rounded-md transition bg-white text-emerald-700 shadow-sm font-semibold";
                btnGram.className = "px-2.5 py-1 rounded-md transition text-slate-500 hover:text-slate-800 font-semibold";
                labelCarb.innerText = "คาร์บ (ส่วน)";
                labelProtein.innerText = "โปรตีน (ส่วน)";
                labelFat.innerText = "ไขมัน (ส่วน)";
                if(banner) banner.classList.remove('hidden');
            }
            syncCalculations();
        }

        function syncCalculations() {
            const carbInput = parseFloat(document.getElementById('input-carb').value) || 0;
            const proteinInput = parseFloat(document.getElementById('input-protein').value) || 0;
            const fatInput = parseFloat(document.getElementById('input-fat').value) || 0;

            let carbGrams = 0, proteinGrams = 0, fatGrams = 0;

            if (appState.logMode === 'gram') {
                carbGrams = carbInput;
                proteinGrams = proteinInput;
                fatGrams = fatInput;

                document.getElementById('converted-carb').innerText = `= ${(carbGrams / 30).toFixed(1)} ส่วน`;
                document.getElementById('converted-protein').innerText = `= ${(proteinGrams / 25).toFixed(1)} ส่วน`;
                document.getElementById('converted-fat').innerText = `= ${(fatGrams / 15).toFixed(1)} ส่วน`;
            } else {
                carbGrams = carbInput * 30;
                proteinGrams = proteinInput * 25;
                fatGrams = fatInput * 15;

                document.getElementById('converted-carb').innerText = `= ${carbGrams.toFixed(0)} กรัม`;
                document.getElementById('converted-protein').innerText = `= ${proteinGrams.toFixed(0)} กรัม`;
                document.getElementById('converted-fat').innerText = `= ${fatGrams.toFixed(0)} กรัม`;
            }

            const totalCal = (carbGrams * 4) + (proteinGrams * 4) + (fatGrams * 9);
            document.getElementById('form-total-cal').innerText = Math.round(totalCal);
        }

        function handleFoodSubmit(e) {
            e.preventDefault();
            const nameInput = document.getElementById('food-name');
            const name = nameInput.value.trim() || 'มื้ออาหารทั่วไป';

            const carbVal = parseFloat(document.getElementById('input-carb').value) || 0;
            const proteinVal = parseFloat(document.getElementById('input-protein').value) || 0;
            const fatVal = parseFloat(document.getElementById('input-fat').value) || 0;

            if (carbVal === 0 && proteinVal === 0 && fatVal === 0) {
                showToast('กรุณากรอกสารอาหารอย่างน้อย 1 ช่อง');
                return;
            }

            let carbGrams = carbVal;
            let proteinGrams = proteinVal;
            let fatGrams = fatVal;

            if (appState.logMode === 'portion') {
                carbGrams = carbVal * 30;
                proteinGrams = proteinVal * 25;
                fatGrams = fatVal * 15;
            }

            const cal = Math.round((carbGrams * 4) + (proteinGrams * 4) + (fatGrams * 9));

            const newMeal = {
                id: Date.now().toString(),
                date: appState.selectedDate,
                name: name,
                carb: Math.round(carbGrams * 10) / 10,
                protein: Math.round(proteinGrams * 10) / 10,
                fat: Math.round(fatGrams * 10) / 10,
                cal: cal
            };

            appState.meals.push(newMeal);

            if (nameInput.value.trim() !== '') {
                const existingMemoryIdx = appState.foodMemory.findIndex(f => f.name.toLowerCase() === name.toLowerCase());
                const memoryItem = { name: name, carb: carbGrams, protein: proteinGrams, fat: fatGrams };
                if (existingMemoryIdx >= 0) {
                    appState.foodMemory[existingMemoryIdx] = memoryItem;
                } else {
                    appState.foodMemory.push(memoryItem);
                }
            }

            saveStateToStorage();

            nameInput.value = '';
            document.getElementById('input-carb').value = '';
            document.getElementById('input-protein').value = '';
            document.getElementById('input-fat').value = '';
            document.getElementById('autocomplete-list').classList.add('hidden');
            document.getElementById('autocomplete-ghost').innerText = '';

            syncCalculations();
            renderDashboard();
            renderHistoryLogs();
            showToast('บันทึกอาหารเรียบร้อย');
        }

        function handleFoodNameInput(val) {
            const listEl = document.getElementById('autocomplete-list');
            const ghostEl = document.getElementById('autocomplete-ghost');
            if (!val || appState.foodMemory.length === 0) {
                listEl.classList.add('hidden');
                ghostEl.innerHTML = '';
                return;
            }

            const matches = appState.foodMemory.filter(item => item.name.toLowerCase().includes(val.toLowerCase()));
            
            if (matches.length > 0) {
                const firstMatch = matches[0];
                if (firstMatch.name.toLowerCase().startsWith(val.toLowerCase())) {
                    const typedPart = val;
                    const remainingPart = firstMatch.name.slice(val.length);
                    
                    ghostEl.innerHTML = `<span class="opacity-0">${escapeHtml(typedPart)}</span><span class="text-slate-400 font-normal opacity-60">${escapeHtml(remainingPart)}</span><span class="ml-2 text-[10px] bg-emerald-100 text-emerald-700 px-1.5 py-0.5 rounded-md font-semibold pointer-events-auto cursor-pointer" onclick="selectAutocomplete('${escapeHtml(firstMatch.name)}')">แตะเลือก ↵</span>`;
                } else {
                    ghostEl.innerHTML = '';
                }

                listEl.innerHTML = matches.map(item => `
                    <div onclick="selectAutocomplete('${item.name.replace(/'/g, "\\'")}')" class="px-3 py-2 text-xs hover:bg-slate-100 cursor-pointer flex justify-between items-center transition">
                        <span class="font-semibold text-slate-800">${escapeHtml(item.name)}</span>
                        <span class="text-[10px] text-slate-400">C:${item.carb}g P:${item.protein}g F:${item.fat}g</span>
                    </div>
                `).join('');
                listEl.classList.remove('hidden');
            } else {
                listEl.classList.add('hidden');
                ghostEl.innerHTML = '';
            }
        }

        function selectAutocomplete(name) {
            const item = appState.foodMemory.find(f => f.name === name);
            if (!item) return;

            document.getElementById('food-name').value = item.name;
            document.getElementById('autocomplete-ghost').innerHTML = '';
            document.getElementById('autocomplete-list').classList.add('hidden');

            if (appState.logMode === 'gram') {
                document.getElementById('input-carb').value = item.carb;
                document.getElementById('input-protein').value = item.protein;
                document.getElementById('input-fat').value = item.fat;
            } else {
                document.getElementById('input-carb').value = (item.carb / 30).toFixed(1);
                document.getElementById('input-protein').value = (item.protein / 25).toFixed(1);
                document.getElementById('input-fat').value = (item.fat / 15).toFixed(1);
            }
            syncCalculations();
        }

        function handleFoodNameKeyDown(e) {
            if (e.key === 'Tab' || e.key === 'ArrowRight' || e.key === 'Enter') {
                const listEl = document.getElementById('autocomplete-list');
                const val = document.getElementById('food-name').value.trim();
                if (val && appState.foodMemory.length > 0) {
                    const match = appState.foodMemory.find(item => item.name.toLowerCase().startsWith(val.toLowerCase()));
                    if (match && e.key !== 'Enter') {
                        e.preventDefault();
                        selectAutocomplete(match.name);
                    }
                }
            }
        }

        function handleWeightSubmit(e) {
            e.preventDefault();
            const val = parseFloat(document.getElementById('weight-input-val').value);
            if (!val) return;

            const existingIndex = appState.weights.findIndex(w => w.date === appState.selectedDate);
            if (existingIndex >= 0) {
                appState.weights[existingIndex].weight = val;
            } else {
                appState.weights.push({ id: Date.now().toString(), date: appState.selectedDate, weight: val });
            }

            appState.weights.sort((a, b) => new Date(a.date) - new Date(b.date));

            appState.profile.weight = val;
            document.getElementById('prof-weight').value = val;
            calculateFFMAndTargets();

            saveStateToStorage();
            document.getElementById('weight-input-val').value = '';
            renderWeightLogs();
            renderWeightChart();
            showToast('บันทึกน้ำหนักแล้ว');
        }

        function renderWeightLogs() {
            const listEl = document.getElementById('weight-history-list');
            if (!listEl) return;
            if (appState.weights.length === 0) {
                listEl.innerHTML = '<div class="text-center text-xs text-slate-400 py-4">ยังไม่มีประวัติน้ำหนัก</div>';
                return;
            }

            const sorted = [...appState.weights].sort((a, b) => new Date(b.date) - new Date(a.date));

            listEl.innerHTML = sorted.map((w) => {
                const chronologicalIndex = appState.weights.findIndex(x => x.date === w.date);
                let diffText = '';
                let diffClass = 'text-slate-400';

                if (chronologicalIndex > 0) {
                    const prevWeight = appState.weights[chronologicalIndex - 1].weight;
                    const diff = w.weight - prevWeight;
                    if (diff > 0) {
                        diffText = `+${diff.toFixed(1)} kg`;
                        diffClass = 'text-red-500 bg-red-50 px-2 py-0.5 rounded-full font-semibold';
                    } else if (diff < 0) {
                        diffText = `${diff.toFixed(1)} kg`;
                        diffClass = 'text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded-full font-semibold';
                    } else {
                        diffText = `0.0 kg`;
                    }
                }

                return `
                    <div class="flex items-center justify-between p-2.5 bg-slate-50 border border-slate-100 rounded-xl text-xs">
                        <span class="font-medium text-slate-700">${w.date}</span>
                        <div class="flex items-center space-x-3">
                            <span class="font-bold text-slate-800 text-sm">${w.weight.toFixed(1)} kg</span>
                            <span class="${diffClass} text-[10px]">${diffText}</span>
                            <button type="button" onclick="deleteWeight('${w.id}')" class="text-slate-300 hover:text-red-500">
                                <i class="fa-solid fa-xmark"></i>
                            </button>
                        </div>
                    </div>
                `;
            }).join('');
        }

        function deleteWeight(id) {
            appState.weights = appState.weights.filter(w => w.id !== id);
            saveStateToStorage();
            renderWeightLogs();
            renderWeightChart();
            showToast('ลบประวัติน้ำหนักแล้ว');
        }

        function renderWeightChart() {
            const canvas = document.getElementById('weightChart');
            if (!canvas) return;
            const ctx = canvas.getContext('2d');
            
            if (weightChartInstance) {
                weightChartInstance.destroy();
            }

            const sorted = [...appState.weights].sort((a, b) => new Date(a.date) - new Date(b.date));
            const labels = sorted.map(w => w.date);
            const dataVals = sorted.map(w => w.weight);

            weightChartInstance = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'น้ำหนัก (กก.)',
                        data: dataVals,
                        borderColor: '#16a34a',
                        backgroundColor: 'rgba(22, 163, 74, 0.1)',
                        fill: true,
                        tension: 0.3,
                        pointRadius: 4,
                        pointBackgroundColor: '#16a34a'
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { display: false }
                    },
                    scales: {
                        y: {
                            beginAtZero: false,
                            grid: { color: '#f1f5f9' }
                        },
                        x: {
                            grid: { display: false }
                        }
                    }
                }
            });
        }

        function renderHistoryLogs() {
            const container = document.getElementById('history-logs-container');
            if (!container) return;
            
            if (appState.meals.length === 0) {
                container.innerHTML = '<div class="text-center text-xs text-slate-400 py-6">ยังไม่มีประวัติการบันทึกอาหาร</div>';
                return;
            }

            const grouped = {};
            appState.meals.forEach(m => {
                if (!grouped[m.date]) grouped[m.date] = [];
                grouped[m.date].push(m);
            });

            const sortedDates = Object.keys(grouped).sort((a, b) => new Date(b) - new Date(a));

            container.innerHTML = sortedDates.map(date => {
                const dayMeals = grouped[date];
                const dayTotalCal = dayMeals.reduce((sum, item) => sum + item.cal, 0);

                return `
                    <div class="border border-slate-200 rounded-xl overflow-hidden bg-slate-50/50">
                        <div class="bg-slate-100 px-3 py-2 flex justify-between items-center text-xs font-bold text-slate-700">
                            <span><i class="fa-regular fa-calendar-days text-emerald-600 mr-1.5"></i>${date}</span>
                            <span class="text-emerald-700">${dayTotalCal} kcal</span>
                        </div>
                        <div class="p-2 space-y-1.5 bg-white">
                            ${dayMeals.map(m => `
                                <div class="flex items-center justify-between text-xs p-1.5 rounded-lg hover:bg-slate-50 border border-slate-100">
                                    <div>
                                        <div class="font-medium text-slate-800">${m.name}</div>
                                        <div class="text-[10px] text-slate-400 space-x-1.5">
                                            <span class="text-blue-600">C:${m.carb}g</span>
                                            <span class="text-red-600">P:${m.protein}g</span>
                                            <span class="text-amber-600">F:${m.fat}g</span>
                                        </div>
                                    </div>
                                    <div class="flex items-center space-x-2">
                                        <span class="font-bold text-slate-700">${m.cal} kcal</span>
                                        <button type="button" onclick="openEditMealModal('${m.id}')" class="text-slate-400 hover:text-blue-600 p-1">
                                            <i class="fa-solid fa-pen"></i>
                                        </button>
                                        <button type="button" onclick="deleteMeal('${m.id}')" class="text-slate-400 hover:text-red-600 p-1">
