    <script>
        // Global Application State
        const STATE_KEY = 'nutritrack_app_state';
        
        let appState = {
            selectedDate: getTodayString(),
            logMode: 'gram', // 'gram' or 'portion'
            autoRebalance: true, // Auto shift macro if exceeded
            profile: {
                gender: 'male',
                age: 25,
                height: 170,
                weight: 65,
                bodyFat: null,
                eee: 300,
                targetEA: 30,
                proteinRatio: 1.8,
                carbPercent: 60,
                targetCal: 0,
                targetCarb: 0,
                targetProtein: 0,
                targetFat: 0
            },
            meals: [],
            weights: [],
            foodMemory: []
        };

        let weightChartInstance = null;

        function escapeHtml(str) {
            return String(str).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;').replace(/'/g, '&#039;');
        }

        window.addEventListener('DOMContentLoaded', () => {
            // ป้องกันการใช้นิ้วถ่างซูม (Pinch to zoom)
            document.addEventListener('touchstart', function (e) {
                if (e.touches.length > 1) {
                    e.preventDefault();
                }
            }, { passive: false });

            // ป้องกันการกดเบิ้ลเพื่อซูม (Double tap to zoom)
            let lastTouchEnd = 0;
            document.addEventListener('touchend', function (e) {
                const now = Date.now();
                if (now - lastTouchEnd <= 300) {
                    e.preventDefault();
                }
                lastTouchEnd = now;
            }, false);

            // ป้องกัน Gesture Zoom บน Safari/iOS
            document.addEventListener('gesturestart', function (e) {
                e.preventDefault();
            });

            // ป้องกันการหมุนลูกกลิ้งเมาส์ร่วมกับกด Ctrl บนคอมพิวเตอร์
            document.addEventListener('wheel', function (e) {
                if (e.ctrlKey) {
                    e.preventDefault();
                }
            }, { passive: false });

            loadStateFromStorage();
            
            // Set date picker default value
            const datePicker = document.getElementById('date-picker');
            if (datePicker) {
                datePicker.value = appState.selectedDate || getTodayString();
                updateDateDisplayLabel();
            }

            // Populate form values from profile state
            if (document.getElementById('prof-gender')) document.getElementById('prof-gender').value = appState.profile.gender || 'male';
            if (document.getElementById('prof-age')) document.getElementById('prof-age').value = appState.profile.age || 25;
            if (document.getElementById('prof-height')) document.getElementById('prof-height').value = appState.profile.height || 170;
            if (document.getElementById('prof-weight')) document.getElementById('prof-weight').value = appState.profile.weight || 65;
            if (document.getElementById('prof-bf')) document.getElementById('prof-bf').value = appState.profile.bodyFat !== null && appState.profile.bodyFat !== undefined ? appState.profile.bodyFat : '';
            if (document.getElementById('prof-eee')) document.getElementById('prof-eee').value = appState.profile.eee;
            if (document.getElementById('prof-ea')) document.getElementById('prof-ea').value = appState.profile.targetEA;
            if (document.getElementById('prof-prot-ratio')) document.getElementById('prof-prot-ratio').value = appState.profile.proteinRatio;
            if (document.getElementById('prof-carb-ratio')) {
                document.getElementById('prof-carb-ratio').value = appState.profile.carbPercent || 60;
            }
            if (document.getElementById('auto-rebalance-toggle')) {
                document.getElementById('auto-rebalance-toggle').checked = appState.autoRebalance !== false;
            }

            // Calculate initial targets and render layout
            calculateFFMAndTargets();
            setLogMode(appState.logMode || 'gram');
            renderDashboard();
            renderWeightLogs();
            renderHistoryLogs();
        });

        function getTodayString() {
            const d = new Date();
            const year = d.getFullYear();
            const month = String(d.getMonth() + 1).padStart(2, '0');
            const day = String(d.getDate()).padStart(2, '0');
            return `${year}-${month}-${day}`;
        }

        function switchTab(tabId) {
            const tabs = ['tab-dashboard', 'tab-calc', 'tab-weight', 'tab-history'];
            tabs.forEach(id => {
                const el = document.getElementById(id);
                if (el) el.classList.add('hidden');
                
                const navBtn = document.getElementById('nav-' + id);
                if (navBtn) {
                    navBtn.classList.remove('text-emerald-600');
                    navBtn.classList.add('text-slate-400');
                }
            });

            const targetEl = document.getElementById(tabId);
            if (targetEl) targetEl.classList.remove('hidden');

            const targetNav = document.getElementById('nav-' + tabId);
            if (targetNav) {
                targetNav.classList.remove('text-slate-400');
                targetNav.classList.add('text-emerald-600');
            }

            if (tabId === 'tab-weight') {
                renderWeightChart();
            }
        }

        function updateDateDisplayLabel() {
            const picker = document.getElementById('date-picker');
            const display = document.getElementById('current-date-display');
            if (!picker || !display) return;
            
            const selected = picker.value;
            const today = getTodayString();
            
            if (selected === today) {
                display.innerText = 'วันนี้';
            } else {
                const parts = selected.split('-');
                display.innerText = `${parts[2]}/${parts[1]}/${parts[0]}`;
            }
        }

        function changeDate(delta) {
            const picker = document.getElementById('date-picker');
            if (!picker.value) picker.value = getTodayString();
            
            const current = new Date(picker.value);
            current.setDate(current.getDate() + delta);
            
            const year = current.getFullYear();
            const month = String(current.getMonth() + 1).padStart(2, '0');
            const day = String(current.getDate()).padStart(2, '0');
            const newStr = `${year}-${month}-${day}`;
            
            picker.value = newStr;
            appState.selectedDate = newStr;
            updateDateDisplayLabel();
            renderDashboard();
        }

        function onDateSelected(val) {
            appState.selectedDate = val || getTodayString();
            updateDateDisplayLabel();
            renderDashboard();
        }

        function calculateFFMAndTargets() {
            const gender = document.getElementById('prof-gender').value;
            const age = parseFloat(document.getElementById('prof-age').value) || 25;
            const height = parseFloat(document.getElementById('prof-height').value) || 170;
            const weight = parseFloat(document.getElementById('prof-weight').value) || 65;
            let bfInput = document.getElementById('prof-bf').value;
            
            let bodyFat = bfInput !== '' ? parseFloat(bfInput) : null;
            
            if (bodyFat === null || isNaN(bodyFat)) {
                const bmi = weight / ((height / 100) * (height / 100));
                if (gender === 'male') {
                    bodyFat = Math.max(8, Math.min(35, (1.20 * bmi) + (0.23 * age) - 16.2));
                } else {
                    bodyFat = Math.max(14, Math.min(45, (1.20 * bmi) + (0.23 * age) - 5.4));
                }
            }

            const ffm = weight * (1 - (bodyFat / 100));
            document.getElementById('display-ffm').innerText = ffm.toFixed(2);

            const eee = parseFloat(document.getElementById('prof-eee').value) || 0;
            const targetEA = parseFloat(document.getElementById('prof-ea').value) || 30;
            const proteinRatio = parseFloat(document.getElementById('prof-prot-ratio').value) || 1.8;
            const carbPercent = parseFloat(document.getElementById('prof-carb-ratio')?.value) || 60;
            const fatPercent = 100 - carbPercent;

            document.getElementById('display-ea-val').innerText = targetEA + ' kcal/kg FFM';
            document.getElementById('display-prot-val').innerText = proteinRatio.toFixed(1) + ' g / kg';
            if(document.getElementById('display-carb-fat-ratio')) {
                document.getElementById('display-carb-fat-ratio').innerText = `คาร์บ ${carbPercent}% : ไขมัน ${fatPercent}%`;
            }

            const targetEI = (targetEA * ffm) + eee;
            const targetProteinGrams = weight * proteinRatio;
            const proteinCal = targetProteinGrams * 4;

            const remainingCal = Math.max(0, targetEI - proteinCal);
            const targetCarbGrams = (remainingCal * (carbPercent / 100)) / 4;
            const targetFatGrams = (remainingCal * (fatPercent / 100)) / 9;

            appState.profile = {
                gender, age, height, weight, bodyFat, eee, targetEA, proteinRatio, carbPercent,
                targetCal: Math.round(targetEI),
                targetCarb: Math.round(targetCarbGrams),
                targetProtein: Math.round(targetProteinGrams),
                targetFat: Math.round(targetFatGrams)
            };

            document.getElementById('res-target-cal').innerText = appState.profile.targetCal + ' kcal';
            document.getElementById('res-target-carb').innerText = appState.profile.targetCarb + 'g';
            document.getElementById('res-target-carb-p').innerText = (appState.profile.targetCarb / 30).toFixed(1) + ' ส่วน';
            
            document.getElementById('res-target-prot').innerText = appState.profile.targetProtein + 'g';
            document.getElementById('res-target-prot-p').innerText = (appState.profile.targetProtein / 25).toFixed(1) + ' ส่วน';
            
            document.getElementById('res-target-fat').innerText = appState.profile.targetFat + 'g';
            document.getElementById('res-target-fat-p').innerText = (appState.profile.targetFat / 15).toFixed(1) + ' ส่วน';

            renderDashboard();
        }

        function toggleAutoRebalance(checked) {
            appState.autoRebalance = checked;
            saveStateToStorage();
            renderDashboard();
            showToast(checked ? 'เปิดระบบโยกสารอาหารอัตโนมัติ' : 'ปิดระบบโยกสารอาหารอัตโนมัติ');
        }

        function renderDashboard() {
            const todayMeals = appState.meals.filter(m => m.date === appState.selectedDate);

            let consumedCal = 0, consumedCarb = 0, consumedProtein = 0, consumedFat = 0;
            todayMeals.forEach(m => {
                consumedCal += m.cal;
                consumedCarb += m.carb;
                consumedProtein += m.protein;
                consumedFat += m.fat;
            });

            let autoCarbOffset = 0;
            let autoFatOffset = 0;

            const baseTargetCarb = appState.profile.targetCarb;
            const baseTargetFat = appState.profile.targetFat;

            // Auto Rebalance logic
            const autoBanner = document.getElementById('auto-rebalance-banner');
            const autoText = document.getElementById('auto-rebalance-text');

            if (appState.autoRebalance) {
                if (consumedCarb > baseTargetCarb) {
                    const excessCarbGrams = consumedCarb - baseTargetCarb;
                    const excessCarbCal = excessCarbGrams * 4;
                    autoFatOffset = -(excessCarbCal / 9); // reduce fat target
                    if (autoBanner && autoText) {
                        autoText.innerText = `⚡ คาร์บเกิน ${excessCarbGrams.toFixed(1)}g ➔ หักไขมันอัตโนมัติ ${Math.abs(autoFatOffset).toFixed(1)}g (${Math.round(excessCarbCal)} kcal)`;
                        autoBanner.classList.remove('hidden');
                    }
                } else if (consumedFat > baseTargetFat) {
                    const excessFatGrams = consumedFat - baseTargetFat;
                    const excessFatCal = excessFatGrams * 9;
                    autoCarbOffset = -(excessFatCal / 4); // reduce carb target
                    if (autoBanner && autoText) {
                        autoText.innerText = `⚡ ไขมันเกิน ${excessFatGrams.toFixed(1)}g ➔ หักคาร์บอัตโนมัติ ${Math.abs(autoCarbOffset).toFixed(1)}g (${Math.round(excessFatCal)} kcal)`;
                        autoBanner.classList.remove('hidden');
                    }
                } else {
                    if (autoBanner) autoBanner.classList.add('hidden');
                }
            } else {
                if (autoBanner) autoBanner.classList.add('hidden');
            }

            const adjustedTargetCarb = Math.max(0, baseTargetCarb + autoCarbOffset);
            const adjustedTargetFat = Math.max(0, baseTargetFat + autoFatOffset);
            const targetProtein = appState.profile.targetProtein;
            const targetCal = appState.profile.targetCal;

            // Calorie Banner Updates
            document.getElementById('dash-cal-consumed').innerText = Math.round(consumedCal);
            document.getElementById('dash-cal-target').innerText = targetCal;
            const remainingCal = targetCal - Math.round(consumedCal);
            document.getElementById('dash-cal-remaining').innerText = (remainingCal >= 0 ? remainingCal : 0) + ' kcal';
            
            const calPercent = targetCal > 0 ? Math.min(100, Math.round((consumedCal / targetCal) * 100)) : 0;
            document.getElementById('dash-cal-bar').style.width = calPercent + '%';
            document.getElementById('dash-cal-percent').innerText = calPercent;
