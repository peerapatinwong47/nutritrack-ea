<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, shrink-to-fit=no">
    <title>NutriTrack - ระบบจดสารอาหาร & คำนวณ EA</title>
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Google Fonts: Kanit -->
    <link href="https://fonts.googleapis.com/css2?family=Kanit:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Chart.js for Weight Graph -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Kanit', 'sans-serif'],
                    },
                    colors: {
                        brand: {
                            50: '#f0fdf4',
                            100: '#dcfce7',
                            500: '#22c55e',
                            600: '#16a34a',
                            700: '#15803d',
                            dark: '#0f172a'
                        },
                        carb: '#3b82f6',
                        protein: '#ef4444',
                        fat: '#f59e0b'
                    }
                }
            }
        }
    </script>
    <style>
        body {
            font-family: 'Kanit', sans-serif;
            background-color: #f8fafc;
            user-select: none;
            -webkit-tap-highlight-color: transparent;
            touch-action: pan-x pan-y;
        }
        /* ป้องกัน iOS Safari ซูมอัตโนมัติเมื่อกดเลือกช่องกรอกข้อมูล (Input Focus Auto-Zoom Fix) */
        @media screen and (max-width: 768px) {
            input[type="text"],
            input[type="number"],
            input[type="date"],
            select,
            textarea {
                font-size: 16px !important;
            }
        }
        ::-webkit-scrollbar {
            width: 4px;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 4px;
        }
        .hide-scrollbar::-webkit-scrollbar {
            display: none;
        }
        .hide-scrollbar {
            -ms-overflow-style: none;
            scrollbar-width: none;
        }
    </style>
</head>
<body class="text-slate-800 antialiased min-h-screen pb-20">
    <div id="app" class="max-w-md mx-auto bg-white min-h-screen shadow-xl relative flex flex-col">

        <!-- Top Header -->
        <header class="sticky top-0 z-30 bg-white/95 backdrop-blur-md border-b border-slate-100 px-4 py-3 flex items-center justify-between">
            <div class="flex items-center space-x-2">
                <div class="w-8 h-8 rounded-full bg-emerald-500 text-white flex items-center justify-center font-bold text-lg shadow-sm">
                    <i class="fa-solid fa-apple-whole text-sm"></i>
                </div>
                <div>
                    <div class="flex items-baseline space-x-1.5">
                        <h1 class="text-base font-bold text-slate-800 leading-tight">NutriTrack EA</h1>
                        <span class="text-[10px] font-normal text-slate-400 italic">by pooh</span>
                    </div>
                    <p id="current-date-display" class="text-xs text-slate-400">วันนี้</p>
                </div>
            </div>
            <!-- Date Switcher -->
            <div class="flex items-center space-x-1 bg-slate-100 p-1 rounded-xl">
                <button onclick="changeDate(-1)" class="w-7 h-7 flex items-center justify-center text-slate-600 rounded-lg hover:bg-white transition text-xs">
                    <i class="fa-solid fa-chevron-left"></i>
                </button>
                <input type="date" id="date-picker" onchange="onDateSelected(this.value)" class="bg-transparent text-xs font-medium text-slate-700 focus:outline-none cursor-pointer w-24 text-center">
                <button onclick="changeDate(1)" class="w-7 h-7 flex items-center justify-center text-slate-600 rounded-lg hover:bg-white transition text-xs">
                    <i class="fa-solid fa-chevron-right"></i>
                </button>
            </div>
        </header>

        <!-- Main Dynamic View Container -->
        <main class="flex-1 p-4 overflow-y-auto">

            <!-- Combined Dashboard & Food Logging View -->
            <section id="tab-dashboard" class="space-y-4">
                <!-- Calorie & Goal Banner -->
                <div class="bg-gradient-to-br from-emerald-600 to-teal-700 text-white rounded-2xl p-4 shadow-lg relative overflow-hidden">
                    <div class="absolute -right-6 -bottom-6 opacity-10 text-9xl">
                        <i class="fa-solid fa-fire"></i>
                    </div>
                    <div class="flex justify-between items-start mb-2 relative z-10">
                        <div>
                            <span class="text-xs bg-white/20 px-2 py-0.5 rounded-full font-light">เป้าหมายพลังงาน (Reverse EA)</span>
                            <div class="flex items-baseline space-x-1 mt-1">
                                <span id="dash-cal-consumed" class="text-3xl font-extrabold">0</span>
                                <span class="text-sm opacity-80">/ <span id="dash-cal-target">0</span> kcal</span>
                            </div>
                        </div>
                        <div class="text-right">
                            <span class="text-xs opacity-75">คงเหลือ</span>
                            <p id="dash-cal-remaining" class="text-2xl font-bold text-emerald-200">0</p>
                        </div>
                    </div>
                    
                    <!-- Calorie Progress Bar -->
                    <div class="w-full bg-black/20 rounded-full h-2.5 overflow-hidden mt-3">
                        <div id="dash-cal-bar" class="bg-white h-full rounded-full transition-all duration-500" style="width: 0%"></div>
                    </div>
                    <div class="flex justify-between text-[11px] mt-1 opacity-80">
                        <span>ทานแล้ว <span id="dash-cal-percent">0</span>%</span>
                        <span>เป้าหมาย EA: <span id="dash-ea-value">30</span> kcal/kg FFM</span>
                    </div>
                </div>

                <!-- Macro Breakdown Cards -->
                <div class="grid grid-cols-3 gap-2">
                    <!-- Carb Card -->
                    <div class="bg-blue-50/60 border border-blue-100 rounded-xl p-3 text-center relative overflow-hidden">
                        <div class="text-xs font-semibold text-blue-600 mb-1">คาร์โบไฮเดรต</div>
                        <div class="text-base font-bold text-slate-800" id="dash-carb-val">0 / 0g</div>
                        <div class="text-[10px] text-blue-500 font-medium mt-0.5" id="dash-carb-portion">(0 / 0 ส่วน)</div>
                        <div class="w-full bg-blue-200 rounded-full h-1.5 mt-2">
                            <div id="dash-carb-bar" class="bg-blue-500 h-full rounded-full transition-all duration-300" style="width: 0%"></div>
                        </div>
                        <div class="text-[10px] text-slate-500 font-medium mt-1">เหลือ <span id="dash-carb-rem" class="font-bold text-slate-700">0g (0 ส่วน)</span></div>
                    </div>

                    <!-- Protein Card -->
                    <div class="bg-red-50/60 border border-red-100 rounded-xl p-3 text-center relative overflow-hidden">
                        <div class="text-xs font-semibold text-red-600 mb-1">โปรตีน</div>
                        <div class="text-base font-bold text-slate-800" id="dash-protein-val">0 / 0g</div>
                        <div class="text-[10px] text-red-500 font-medium mt-0.5" id="dash-protein-portion">(0 / 0 ส่วน)</div>
                        <div class="w-full bg-red-200 rounded-full h-1.5 mt-2">
                            <div id="dash-protein-bar" class="bg-red-500 h-full rounded-full transition-all duration-300" style="width: 0%"></div>
                        </div>
                        <div class="text-[10px] text-slate-500 font-medium mt-1">เหลือ <span id="dash-protein-rem" class="font-bold text-slate-700">0g (0 ส่วน)</span></div>
                    </div>

                    <!-- Fat Card -->
                    <div class="bg-amber-50/60 border border-amber-100 rounded-xl p-3 text-center relative overflow-hidden">
                        <div class="text-xs font-semibold text-amber-600 mb-1">ไขมัน</div>
                        <div class="text-base font-bold text-slate-800" id="dash-fat-val">0 / 0g</div>
                        <div class="text-[10px] text-amber-600 font-medium mt-0.5" id="dash-fat-portion">(0 / 0 ส่วน)</div>
                        <div class="w-full bg-amber-200 rounded-full h-1.5 mt-2">
                            <div id="dash-fat-bar" class="bg-amber-500 h-full rounded-full transition-all duration-300" style="width: 0%"></div>
                        </div>
                        <div class="text-[10px] text-slate-500 font-medium mt-1">เหลือ <span id="dash-fat-rem" class="font-bold text-slate-700">0g (0 ส่วน)</span></div>
                    </div>
                </div>

                <!-- Combined Quick Food Logging Section -->
                <div class="bg-white border border-slate-200 rounded-2xl p-4 shadow-sm space-y-3">
                    <div class="flex items-center justify-between">
                        <h2 class="text-sm font-bold text-slate-800 flex items-center gap-2">
                            <i class="fa-solid fa-pen-to-square text-emerald-600"></i>
                            จดบันทึกมื้ออาหาร
                        </h2>
                        <!-- Mode Toggle Switcher -->
                        <div class="flex bg-slate-100 p-0.5 rounded-lg text-[11px] font-semibold">
                            <button id="mode-btn-gram" type="button" onclick="setLogMode('gram')" class="px-2.5 py-1 rounded-md transition bg-white text-emerald-700 shadow-sm">
                                กรัม (Micro)
                            </button>
                            <button id="mode-btn-portion" type="button" onclick="setLogMode('portion')" class="px-2.5 py-1 rounded-md transition text-slate-500 hover:text-slate-800">
                                ส่วน (Exchange)
                            </button>
                        </div>
                    </div>

                    <!-- Portion info banner -->
                    <div id="portion-info-banner" class="hidden bg-emerald-50 border border-emerald-100 p-2.5 rounded-xl text-[11px] text-emerald-800">
                        <div class="font-bold mb-0.5">อัตราส่วนสารอาหารต่อ 1 ส่วน:</div>
                        <div class="flex justify-between text-[10px]">
                            <span>• คาร์บ 1 ส่วน = 30g</span>
                            <span>• โปรตีน 1 ส่วน = 25g</span>
                            <span>• ไขมัน 1 ส่วน = 15g</span>
                        </div>
                    </div>

                    <!-- Food Input Form -->
                    <form id="food-form" onsubmit="handleFoodSubmit(event)" class="space-y-3 relative">
                        <!-- Food Name with Autocomplete Ghost Text -->
                        <div class="relative">
                            <label class="block text-[11px] font-semibold text-slate-600 mb-1">ชื่อเมนูอาหาร (ไม่ใส่ก็ได้)</label>
                            <div class="relative flex items-center">
                                <!-- Ghost Overlay Layer (Positioned Exactly Behind Input) -->
                                <div id="autocomplete-ghost" class="absolute inset-0 px-3 py-2 text-sm pointer-events-none flex items-center overflow-hidden whitespace-pre"></div>
                                <input type="text" id="food-name" autocomplete="off" placeholder="เช่น ข้าวผัดอกไก่..." oninput="handleFoodNameInput(this.value)" onkeydown="handleFoodNameKeyDown(event)" class="w-full px-3 py-2 border border-slate-200 rounded-xl text-sm focus:outline-none focus:border-emerald-500 transition relative z-10 bg-transparent text-slate-800 font-medium">
                            </div>
                            <!-- Autocomplete Dropdown List -->
                            <div id="autocomplete-list" class="absolute left-0 right-0 top-full mt-1 bg-white border border-slate-200 rounded-xl shadow-lg z-30 max-h-48 overflow-y-auto hidden divide-y divide-slate-100"></div>
                        </div>

                        <!-- Macro Inputs -->
                        <div class="grid grid-cols-3 gap-2">
                            <!-- Carb Input -->
                            <div>
                                <label id="label-carb" class="block text-[11px] font-semibold text-blue-600 mb-1">คาร์บ (กรัม)</label>
                                <input type="number" step="0.1" min="0" id="input-carb" oninput="syncCalculations()" placeholder="0" class="w-full px-2 py-1.5 bg-blue-50/50 border border-blue-200 rounded-xl text-sm font-bold text-slate-800 focus:outline-none focus:border-blue-500 text-center">
                                <span id="converted-carb" class="block text-[9px] text-slate-400 text-center mt-0.5">= 0 ส่วน</span>
                            </div>

                            <!-- Protein Input -->
                            <div>
                                <label id="label-protein" class="block text-[11px] font-semibold text-red-600 mb-1">โปรตีน (กรัม)</label>
                                <input type="number" step="0.1" min="0" id="input-protein" oninput="syncCalculations()" placeholder="0" class="w-full px-2 py-1.5 bg-red-50/50 border border-red-200 rounded-xl text-sm font-bold text-slate-800 focus:outline-none focus:border-red-500 text-center">
                                <span id="converted-protein" class="block text-[9px] text-slate-400 text-center mt-0.5">= 0 ส่วน</span>
                            </div>

                            <!-- Fat Input -->
                            <div>
                                <label id="label-fat" class="block text-[11px] font-semibold text-amber-600 mb-1">ไขมัน (กรัม)</label>
                                <input type="number" step="0.1" min="0" id="input-fat" oninput="syncCalculations()" placeholder="0" class="w-full px-2 py-1.5 bg-amber-50/50 border border-amber-200 rounded-xl text-sm font-bold text-slate-800 focus:outline-none focus:border-amber-500 text-center">
                                <span id="converted-fat" class="block text-[9px] text-slate-400 text-center mt-0.5">= 0 ส่วน</span>
                            </div>
                        </div>

                        <!-- Calculated Total Calories Banner -->
                        <div class="bg-slate-900 text-white px-3 py-2 rounded-xl flex justify-between items-center text-xs">
                            <span class="text-slate-300">พลังงานมื้อนี้:</span>
                            <span class="text-sm font-bold text-emerald-400"><span id="form-total-cal">0</span> kcal</span>
                        </div>

                        <button type="submit" class="w-full py-2.5 bg-emerald-600 hover:bg-emerald-700 active:scale-[0.99] text-white font-bold rounded-xl shadow-md shadow-emerald-600/20 transition flex items-center justify-center space-x-2 text-xs">
                            <i class="fa-solid fa-plus"></i>
                            <span>บันทึกมื้อนี้</span>
                        </button>
                    </form>
                </div>

                <!-- Automatic Macro Rebalancing Info Card -->
                <div class="bg-white border border-slate-200 rounded-2xl p-4 shadow-sm">
                    <div class="flex items-center justify-between mb-1">
                        <div class="flex items-center space-x-2">
                            <i class="fa-solid fa-arrows-rotate text-emerald-600"></i>
                            <h3 class="text-xs font-bold text-slate-800">ระบบโยกสารอาหารอัตโนมัติ (Carb ↔ Fat)</h3>
                        </div>
                        <!-- Auto-Rebalance Toggle Switch -->
                        <label class="relative inline-flex items-center cursor-pointer">
                            <input type="checkbox" id="auto-rebalance-toggle" onchange="toggleAutoRebalance(this.checked)" class="sr-only peer">
                            <div class="w-8 h-4 bg-slate-200 peer-focus:outline-none rounded-full peer peer-checked:after:translate-x-full peer-checked:after:border-white after:content-[''] after:absolute after:top-[2px] after:left-[2px] after:bg-white after:border-slate-300 after:border after:rounded-full after:h-3 after:w-3 after:transition-all peer-checked:bg-emerald-600"></div>
                            <span class="ml-1.5 text-[10px] font-semibold text-slate-600">ทำงาน</span>
                        </label>
                    </div>
                    
                    <!-- Auto Rebalance Banner Display -->
                    <div id="auto-rebalance-banner" class="hidden my-2 p-2.5 bg-amber-50 border border-amber-200 rounded-xl text-[11px] text-amber-800 flex items-center justify-between">
                        <span id="auto-rebalance-text" class="font-medium">⚡ ระบบกำลังโยกสารอาหารให้อัตโนมัติ</span>
                        <i class="fa-solid fa-bolt text-amber-500"></i>
                    </div>

                    <p class="text-[11px] text-slate-500">ระบบจะทำการสลับโควต้าระหว่างคาร์บและไขมันให้อัตโนมัติทันทีที่ทานอย่างใดอย่างหนึ่งเกินเป้าหมาย โดยรักษาสมดุลแคลลอรี่และโปรตีนให้คงเดิมเสมอ</p>
                </div>

                <!-- Today's Log List -->
                <div class="bg-white border border-slate-200 rounded-2xl p-4 shadow-sm">
                    <div class="flex justify-between items-center mb-3">
                        <h3 class="text-xs font-bold text-slate-800 flex items-center gap-2">
                            <i class="fa-solid fa-utensils text-emerald-600"></i>
                            รายการที่บันทึกวันนี้
                        </h3>
                    </div>

                    <div id="dash-meals-list" class="space-y-2">
                        <!-- Dynamic Meal Items Rendered Here -->
                    </div>
                </div>
            </section>

            <!-- Target Settings Tab -->
            <section id="tab-calc" class="hidden space-y-4">
                <div class="bg-white border border-slate-200 rounded-2xl p-4 shadow-sm">
                    <div class="flex items-center space-x-2 mb-3">
                        <i class="fa-solid fa-calculator text-emerald-600 text-lg"></i>
                        <h2 class="text-base font-bold text-slate-800">คำนวณ TDEE & Reverse EA</h2>
                    </div>

                    <form id="profile-form" onsubmit="saveProfileSettings(event)" class="space-y-4">
                        
                        <!-- Gender & Age -->
                        <div class="grid grid-cols-2 gap-3">
                            <div>
                                <label class="block text-xs font-semibold text-slate-600 mb-1">เพศ</label>
                                <select id="prof-gender" onchange="calculateFFMAndTargets()" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm font-medium focus:outline-none focus:border-emerald-500">
                                    <option value="male">ชาย</option>
                                    <option value="female">หญิง</option>
                                </select>
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-slate-600 mb-1">อายุ (ปี)</label>
                                <input type="number" id="prof-age" value="25" min="10" max="100" oninput="calculateFFMAndTargets()" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm font-medium focus:outline-none focus:border-emerald-500">
                            </div>
                        </div>

                        <!-- Height & Weight -->
                        <div class="grid grid-cols-2 gap-3">
                            <div>
                                <label class="block text-xs font-semibold text-slate-600 mb-1">ส่วนสูง (ซม.)</label>
                                <input type="number" id="prof-height" value="170" step="0.5" oninput="calculateFFMAndTargets()" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm font-medium focus:outline-none focus:border-emerald-500">
                            </div>
                            <div>
                                <label class="block text-xs font-semibold text-slate-600 mb-1">น้ำหนัก (กิโลกรัม)</label>
                                <input type="number" id="prof-weight" value="65" step="0.1" oninput="calculateFFMAndTargets()" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm font-medium focus:outline-none focus:border-emerald-500">
                            </div>
                        </div>

                        <!-- Body Fat % -->
                        <div>
                            <div class="flex justify-between items-center mb-1">
                                <label class="text-xs font-semibold text-slate-600">เปอร์เซ็นต์ไขมัน (% Body Fat)</label>
                                <span class="text-[10px] text-slate-400">*หากไม่ทราบ จะใช้ค่าเฉลี่ย</span>
                            </div>
                            <input type="number" id="prof-bf" placeholder="เช่น 15 (ว่างไว้ = ค่าเฉลี่ย)" step="0.1" min="3" max="60" oninput="calculateFFMAndTargets()" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm font-medium focus:outline-none focus:border-emerald-500">
                            <div class="text-[11px] text-emerald-600 font-medium mt-1">
                                Fat-Free Mass (FFM): <span id="display-ffm" class="font-bold">55.25</span> kg
                            </div>
                        </div>

                        <!-- Exercise Energy Expenditure (EEE) -->
                        <div>
                            <label class="block text-xs font-semibold text-slate-600 mb-1">แคลลอรี่จากการออกกำลังกายเฉลี่ยต่อวัน (EEE)</label>
                            <input type="number" id="prof-eee" value="300" step="10" min="0" oninput="calculateFFMAndTargets()" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl text-sm font-medium focus:outline-none focus:border-emerald-500">
                            <span class="text-[10px] text-slate-400">คำนวณจากแคลลอรี่ที่เผาผลาญจากการออกกำลังกายสัปดาห์ละ 7 วัน</span>
                        </div>

                        <!-- Target EA Slider -->
                        <div class="bg-emerald-50/70 border border-emerald-100 p-3 rounded-xl space-y-2">
                            <div class="flex justify-between items-center">
                                <label class="text-xs font-bold text-emerald-900">เป้าหมาย Energy Availability (EA)</label>
                                <span class="text-sm font-extrabold text-emerald-700 bg-white px-2.5 py-0.5 rounded-lg border border-emerald-200" id="display-ea-val">30 kcal/kg FFM</span>
                            </div>
                            <input type="range" id="prof-ea" min="15" max="50" step="1" value="30" oninput="calculateFFMAndTargets()" class="w-full accent-emerald-600 cursor-pointer">
                            <div class="flex justify-between text-[10px] text-emerald-700 font-medium">
                                <span>15 (ต่ำมาก)</span>
                                <span>30 (สมดุล/ปกติ)</span>
                                <span>45+ (สร้างกล้ามเนื้อ)</span>
                            </div>
                        </div>

                        <!-- Protein Target Slider -->
                        <div class="bg-red-50/70 border border-red-100 p-3 rounded-xl space-y-2">
                            <div class="flex justify-between items-center">
                                <label class="text-xs font-bold text-red-900">เป้าหมายโปรตีนต่อน้ำหนักตัว</label>
                                <span class="text-sm font-extrabold text-red-700 bg-white px-2.5 py-0.5 rounded-lg border border-red-200" id="display-prot-val">1.8 g / kg</span>
                            </div>
                            <input type="range" id="prof-prot-ratio" min="0.8" max="3.0" step="0.1" value="1.8" oninput="calculateFFMAndTargets()" class="w-full accent-red-600 cursor-pointer">
                            <div class="flex justify-between text-[10px] text-red-700 font-medium">
                                <span>0.8g (ทั่วไป)</span>
                                <span>1.8g-2.2g (คุมอาหาร/สร้างกล้าม)</span>
                                <span>3.0g (นักกีฬา)</span>
                            </div>
                        </div>

                        <!-- Carb vs Fat Ratio Slider -->
                        <div class="bg-blue-50/70 border border-blue-100 p-3 rounded-xl space-y-2">
                            <div class="flex justify-between items-center">
                                <label class="text-xs font-bold text-blue-900">สัดส่วนพลังงาน คาร์บ vs ไขมัน</label>
