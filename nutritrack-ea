                        <div>
                            <div class="font-bold text-slate-800 text-xs">${m.name}</div>
                            <div class="text-[10px] text-slate-400 mt-0.5 space-x-2">
                                <span class="text-blue-600 font-medium">C:${m.carb}g</span>
                                <span class="text-red-600 font-medium">P:${m.protein}g</span>
