        function openEditMealModal(id) {
            const meal = appState.meals.find(m => m.id === id);
            if (!meal) return;

            document.getElementById('edit-meal-id').value = meal.id;
            document.getElementById('edit-meal-name').value = meal.name;
            document.getElementById('edit-meal-carb').value = meal.carb;
            document.getElementById('edit-meal-protein').value = meal.protein;
            document.getElementById('edit-meal-fat').value = meal.fat;

            document.getElementById('edit-meal-modal').classList.remove('hidden');
