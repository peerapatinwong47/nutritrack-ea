        function exportBackupJSON() {
            const jsonStr = JSON.stringify(appState, null, 2);
            const blob = new Blob([jsonStr], { type: 'application/json;charset=utf-8' });
            const url = URL.createObjectURL(blob);
            
            const a = document.createElement('a');
            a.href = url;
            a.download = `NutriTrack_Backup_${getTodayString()}.json`;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
            
            showToast('ดาวน์โหลดไฟล์สำรองข้อมูลเรียบร้อย');
        }

        function triggerImportJSON() {
            const fileInput = document.getElementById('import-file-input');
            if (fileInput) fileInput.click();
        }

        function handleFileImport(event) {
            const file = event.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = function(e) {
                try {
                    const imported = JSON.parse(e.target.result);
                    if (imported && (imported.profile || imported.meals || imported.weights)) {
                        appState = { ...appState, ...imported };
                        saveStateToStorage();

                        // Populate form inputs
                        if (document.getElementById('prof-gender')) document.getElementById('prof-gender').value = appState.profile.gender || 'male';
                        if (document.getElementById('prof-age')) document.getElementById('prof-age').value = appState.profile.age || 25;
                        if (document.getElementById('prof-height')) document.getElementById('prof-height').value = appState.profile.height || 170;
                        if (document.getElementById('prof-weight')) document.getElementById('prof-weight').value = appState.profile.weight || 65;
                        if (document.getElementById('prof-bf')) document.getElementById('prof-bf').value = appState.profile.bodyFat !== null && appState.profile.bodyFat !== undefined ? appState.profile.bodyFat : '';
                        if (document.getElementById('prof-eee')) document.getElementById('prof-eee').value = appState.profile.eee;
                        if (document.getElementById('prof-ea')) document.getElementById('prof-ea').value = appState.profile.targetEA;
                        if (document.getElementById('prof-prot-ratio')) document.getElementById('prof-prot-ratio').value = appState.profile.proteinRatio;
                        if (document.getElementById('prof-carb-ratio')) document.getElementById('prof-carb-ratio').value = appState.profile.carbPercent || 60;

                        calculateFFMAndTargets();
                        renderDashboard();
                        renderWeightLogs();
                        renderHistoryLogs();
                        showToast('นำเข้าข้อมูลสำเร็จเรียบร้อย');
                    } else {
                        showToast('รูปแบบไฟล์ไม่ถูกต้อง');
                    }
                } catch (err) {
                    console.error(err);
                    showToast('เกิดข้อผิดพลาดในการอ่านไฟล์');
                }
                event.target.value = '';
            };
            reader.readAsText(file);
        }

        function saveStateToStorage() {
            try {
                localStorage.setItem(STATE_KEY, JSON.stringify(appState));
            } catch (e) {
                console.error('Save failed:', e);
            }
        }

        function loadStateFromStorage() {
            try {
                const stored = localStorage.getItem(STATE_KEY);
                if (stored) {
                    const parsed = JSON.parse(stored);
                    appState = { ...appState, ...parsed };
                    if (!appState.foodMemory) {
                        appState.foodMemory = [];
                    }
                }
            } catch (e) {
                console.error('Load failed:', e);
            }
        }
    </script>
